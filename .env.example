# --- Обязательное ---------------------------------------------------------

# Токен бота от @BotFather
BOT_TOKEN=

# Чем проверять сообщения — нужен ЛИБО ключ ниже, ЛИБО аккаунты нейросети
# (добавляются прямо в боте: /addaccount, email + пароль от DeepSeek или Qwen).
LLM_API_KEY=sk-aitunnel-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.aitunnel.ru/v1

# --- Необязательное -------------------------------------------------------

# Твой Telegram user id. Если не задать — владельцем станет тот,
# кто первым напишет боту /start.
OWNER_ID=

# Что использовать: auto — аккаунты, если добавлены, иначе ключ (и ключ как
# запасной, если аккаунты легли). key — только ключ. accounts — только аккаунты.
LLM_BACKEND=auto
# На сколько минут аккаунт уходит в паузу после ошибки (при лимите — минимум 30)
ACCOUNT_COOLDOWN_MINUTES=20

# Модели нужны только бэкенду по ключу. У аккаунтов модель своя.
# 1-й этап гоняет пачки (нужна дешёвая), 2-й проверяет единицы (можно умнее)
MODEL_STAGE1=gemini-3.6-flash
MODEL_STAGE2=claude-haiku-4.5

# Батч: 100 сообщений или 300 секунд — что раньше
BATCH_SIZE=100
BATCH_TIMEOUT=300

# Сколько сообщений влезает в один промпт 1-го этапа
STAGE1_CHUNK=25
# Сколько проверок 2-го этапа идут параллельно
STAGE2_CONCURRENCY=4

# Чаты с моделью. У каждого этапа свой непрерывный чат, новый диалог на каждое
# сообщение не заводится. Раз в CHAT_TTL_HOURS чат меняется на свежий.
CHAT_TTL_HOURS=6
# Сколько прошлых обменов тащить в следующий запрос (0 — только id чата, без контекста).
# Реплики в истории обрезаются до 400 символов, чтобы не переплачивать за токены.
CHAT_HISTORY_TURNS=1

# Порог уверенности для уведомления (0..1), меняется на лету через /threshold
MIN_CONFIDENCE=0.65
# Короче этого сообщения даже не смотрим
MIN_TEXT_LEN=25

# Антидубль: сколько дней помним сообщения и насколько похожие считаем дублями.
# 0 — только точные совпадения. 12 — ловит и переписанные объявления
# (замер: изменён бюджет — 3, добавлены контакты — 9, другое объявление — 28).
DEDUP_TTL_DAYS=7
DEDUP_HAMMING=12

# Чем ты занимаешься — влияет на отбор. Меняется на лету через /profile
PROFILE=

# Путь к базе и подробные логи
DB_PATH=
DEBUG=
